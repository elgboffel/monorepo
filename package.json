{
  "name": "grably",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "clean": "turbo clean",
    "type-check": "turbo type-check",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs,.astro",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.mjs,.astro --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "syncpack list-mismatches",
    "deps:fix": "syncpack fix-mismatches",
    "prepare": "husky",
    "docker:down": "docker-compose -f .docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f .docker/docker-compose.yml logs -f",
    "docker:restart": "docker-compose -f .docker/docker-compose.yml restart",
    "docker:clean": "docker-compose -f .docker/docker-compose.yml down -v --remove-orphans",
    "docker:dev": "docker-compose -f .docker/docker-compose.yml up -d",
    "docker:prod": "docker-compose -f .docker/docker-compose.yml -f .docker/docker-compose.prod.yml up -d"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/node": "24.2.0",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^16.3.0",
    "husky": "^9.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.1",
    "syncpack": "13.0.4",
    "turbo": "2.5.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@8.0.0",
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11"
  }
}
