---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import { InfoCard } from "../components/InfoCard";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@project/ui/components/card";
---

<Layout title="Home - monorepo Monorepo">
  <Navigation />

  <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-foreground mb-4">
        Welcome to the Web App
      </h1>
      <p class="text-xl text-muted-foreground">
        Built with Astro, React, TypeScript, and Tailwind CSS in a monorepo
        setup.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <Card>
        <CardHeader>
          <CardTitle>Monorepo Features</CardTitle>
          <CardDescription>
            This application demonstrates modern monorepo architecture
          </CardDescription>
        </CardHeader>
        <CardContent>
          <ul class="space-y-2">
            <li class="flex items-center">
              <span class="w-2 h-2 bg-primary rounded-full mr-3"></span>
              Built with Astro and React
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-primary rounded-full mr-3"></span>
              Uses @project/common packages for common functionality
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-primary rounded-full mr-3"></span>
              Styled with Tailwind CSS and shadcn/ui
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-primary rounded-full mr-3"></span>
              Part of a pnpm + Turborepo monorepo
            </li>
          </ul>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Technology Stack</CardTitle>
          <CardDescription>
            Modern tools and frameworks used in this project
          </CardDescription>
        </CardHeader>
        <CardContent>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <h4 class="font-semibold mb-2">Frontend</h4>
              <ul class="text-sm space-y-1">
                <li>Astro</li>
                <li>React</li>
                <li>TypeScript</li>
                <li>Tailwind CSS</li>
              </ul>
            </div>
            <div>
              <h4 class="font-semibold mb-2">Tooling</h4>
              <ul class="text-sm space-y-1">
                <li>pnpm workspaces</li>
                <li>Turborepo</li>
                <li>ESLint</li>
                <li>Prettier</li>
              </ul>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>

    <InfoCard client:load />
  </main>
</Layout>
