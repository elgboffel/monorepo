---
import Layout from '../layouts/Layout.astro';
import { getMessage } from '@project/shared/helpers';
---

<Layout title="Test - Grably Monorepo">
  <main class="max-w-7xl mx-auto py-6 px-4">
    <h1 class="text-4xl font-bold mb-4">Test Page</h1>
    <p class="text-xl mb-4">
      This is a simple test page to verify Astro is working.
    </p>
    <p class="text-lg">Message from @project/shared package: {getMessage()}</p>
  </main>
</Layout>
