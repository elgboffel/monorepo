---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import { InfoCard } from "../components/InfoCard";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@project/ui/components/card";
---

<Layout title="API Info - monorepo Monorepo">
  <Navigation />

  <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-foreground mb-4">API Information</h1>
      <p class="text-xl text-muted-foreground">
        Documentation for the REST API server running alongside this web app.
      </p>
    </div>

    <div class="space-y-6">
      <Card>
        <CardHeader>
          <CardTitle>API Server Details</CardTitle>
          <CardDescription>
            Information about the Express.js API server
          </CardDescription>
        </CardHeader>
        <CardContent>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h4 class="font-semibold mb-3">Server Information</h4>
              <ul class="space-y-2">
                <li><strong>Framework:</strong> Express.js with TypeScript</li>
                <li><strong>Port:</strong> 3000</li>
                <li>
                  <strong>Base URL:</strong>
                  <code class="bg-muted px-2 py-1 rounded"
                    >http://localhost:3000</code
                  >
                </li>
              </ul>
            </div>
            <div>
              <h4 class="font-semibold mb-3">Features</h4>
              <ul class="space-y-2">
                <li>JSON API responses</li>
                <li>Health check endpoint</li>
                <li>@project/shared package integration</li>
                <li>TypeScript type safety</li>
              </ul>
            </div>
          </div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Available Endpoints</CardTitle>
          <CardDescription> REST API endpoints you can test </CardDescription>
        </CardHeader>
        <CardContent>
          <div class="space-y-4">
            <div class="border rounded-lg p-4">
              <div class="flex items-center mb-2">
                <span
                  class="bg-green-100 text-green-800 px-2 py-1 rounded text-sm font-medium mr-3"
                  >GET</span
                >
                <code class="text-lg">/</code>
              </div>
              <p class="text-muted-foreground mb-2">
                Welcome endpoint with app information
              </p>
              <p class="text-sm">
                <strong>Response:</strong> JSON with app name, message, version,
                date, and timestamp
              </p>
            </div>

            <div class="border rounded-lg p-4">
              <div class="flex items-center mb-2">
                <span
                  class="bg-green-100 text-green-800 px-2 py-1 rounded text-sm font-medium mr-3"
                  >GET</span
                >
                <code class="text-lg">/health</code>
              </div>
              <p class="text-muted-foreground mb-2">Health check endpoint</p>
              <p class="text-sm">
                <strong>Response:</strong> JSON with status and uptime information
              </p>
            </div>

            <div class="border rounded-lg p-4">
              <div class="flex items-center mb-2">
                <span
                  class="bg-green-100 text-green-800 px-2 py-1 rounded text-sm font-medium mr-3"
                  >GET</span
                >
                <code class="text-lg">/api/message</code>
              </div>
              <p class="text-muted-foreground mb-2">
                Get message from @project/shared package
              </p>
              <p class="text-sm">
                <strong>Response:</strong> JSON with message from @project/shared
                utilities
              </p>
            </div>
          </div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Testing the API</CardTitle>
          <CardDescription> How to test the API endpoints </CardDescription>
        </CardHeader>
        <CardContent>
          <div class="space-y-4">
            <div>
              <h4 class="font-semibold mb-2">Using curl</h4>
              <div class="bg-muted p-4 rounded-lg">
                <pre
                  class="text-sm"><code>curl http://localhost:3000/
curl http://localhost:3000/health
curl http://localhost:3000/api/message</code></pre>
              </div>
            </div>
            <div>
              <h4 class="font-semibold mb-2">Using your browser</h4>
              <p class="text-muted-foreground mb-2">
                You can visit these URLs directly in your browser:
              </p>
              <ul class="space-y-1">
                <li>
                  <a
                    href="http://localhost:3000"
                    target="_blank"
                    class="text-primary hover:underline"
                    >http://localhost:3000</a
                  >
                </li>
                <li>
                  <a
                    href="http://localhost:3000/health"
                    target="_blank"
                    class="text-primary hover:underline"
                    >http://localhost:3000/health</a
                  >
                </li>
                <li>
                  <a
                    href="http://localhost:3000/api/message"
                    target="_blank"
                    class="text-primary hover:underline"
                    >http://localhost:3000/api/message</a
                  >
                </li>
              </ul>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>

    <InfoCard client:load />
  </main>
</Layout>
